---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import changelogData from "../../data/changelog.json";
import featuredIds from "../../data/featured.json";

interface ChangelogEntry {
  date: string;
  type: "new-problem" | "status-change";
  id: number;
  name?: string;
  old_status?: string;
  new_status?: string;
}

// changelog.json is append-only in true chronological order, so reversing it
// (rather than sorting by date) is what actually gets same-day entries right.
const recentChanges = (changelogData as ChangelogEntry[]).slice().reverse().slice(0, 10);

const featuredProblems =
  (featuredIds as number[]).length > 0
    ? (await getCollection("problems")).filter((p) => (featuredIds as number[]).includes(p.data.id))
    : [];

function changeTitle(entry: ChangelogEntry): string {
  return entry.name ?? `Problem #${entry.id}`;
}

function changeTypeLabel(entry: ChangelogEntry): string {
  return entry.type === "new-problem" ? "New problem" : "Status changed";
}
---

<BaseLayout title="Home" description="A collection of open problems in mathematical logic.">
  <div class="intro">
    <picture>
      <source media="(max-width: 600px)" srcset="/thinker_crop.png" />
      <img class="hero" src="/thinker.png" alt="" />
    </picture>

    <h1>Open Problems in Mathematical Logic</h1>
    <p>
    The goal of this website is to collect open problems in mathematical logic and to track credible attempts to resolve them. Each problem has its own page with a precise statement of the problem and its current status, as well as other relevant information. Anyone can suggest edits to an existing problem or propose a new problem; see the <a href="/faq">FAQ</a> for information on how to do this. Check out the <a href="/problems">list of problems</a> for a list of all problems currently on the site or use the <a href="/search">search feature</a> to search for problems containing specific keywords. 
    </p>

    <p>
    This website was partially inspired by the <a href="https://www.erdosproblems.com/">Erdős Problems website</a> and by the role that website has played in tracking proposed solutions to open problems produced by AI models. For this reason, the focus of this website will be on problems whose resolution would be of reasonably high interest to the mathematical logic community. In addition, each problem comes with an optional section which records credible proof attempts (even if they have not yet been fully verified). See the <a href="/faq">FAQ</a> for more information about what kinds of problems are accepted and how to report a credible proof attempt.
    </p>
    
    <p>
    This site is maintained by <a href="https://websites.umich.edu/~pglutz/">Patrick Lutz</a>. To report problems with the website or make suggestions, feel free to email <a href="mailto:admin@openlogicproblems.com">admin@openlogicproblems.com</a> or open an issue on <a href="https://github.com/pglutz/open-logic-problems">GitHub</a>.
    </p>
  </div>

  <section>
    <h2>Recent Changes</h2>
    {
      recentChanges.length === 0 ? (
        <p class="muted">No changes recorded yet.</p>
      ) : (
        <ul class="changes panel-box">
          {recentChanges.map((entry) => (
            <li>
              <div class="entry-line">
                <span class="muted entry-date">{entry.date}</span>
                <strong class={`change-label change-${entry.type}`}>{changeTypeLabel(entry)}</strong>
                <a href={`/problems/${entry.id}`}>{changeTitle(entry)}</a>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    featuredProblems.length > 0 && (
      <section>
        <h2>Featured Problems</h2>
        <ul>
          {featuredProblems.map((p) => (
            <li>
              <a href={`/problems/${p.data.id}`}>{p.data.name ?? `Problem #${p.data.id}`}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .intro {
    overflow: auto;
  }
  .hero {
    float: right;
    width: min(220px, 40%);
    height: auto;
    border-radius: var(--radius-lg);
    margin: 1.5rem 0 1rem 1.25rem;
  }
  @media (max-width: 600px) {
    .hero {
      float: none;
      display: block;
      width: 100%;
      margin: 0 0 1.25rem;
    }
  }
  .changes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .changes li {
    padding: 0.5rem 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .changes li:last-child {
    border-bottom: none;
  }
  .panel-box {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 0.25rem 1.25rem;
    background: rgba(128, 128, 128, 0.06);
  }
  .entry-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }
  .entry-date {
    display: inline-block;
    min-width: 5.5rem;
  }
  .change-label {
    display: inline-block;
    min-width: 8.25rem;
    white-space: nowrap;
  }
  .change-label.change-new-problem {
    color: #5f23c7;
  }
  .change-label.change-status-change {
    color: #c5205d;
  }
</style>
