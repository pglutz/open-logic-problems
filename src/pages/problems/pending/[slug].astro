---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProblemBody from "../../../components/react/ProblemBody";
import { renderMarkdown, renderIfPresent } from "../../../lib/markdown/pipeline";
import { splitSections } from "../../../lib/markdown/sections";

export async function getStaticPaths() {
  const pendingProblems = await getCollection("pendingProblems");
  return pendingProblems.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const sections = splitSections(entry.body ?? "");
const validKeys = new Set(
  [entry.data.canonical_reference.key, ...entry.data.references.map((r) => r.key)].filter(
    (k): k is string => !!k,
  ),
);

const [statementHtml, definitionsHtml, partialResultsHtml, claimedProofsHtml, notesHtml] = await Promise.all([
  renderMarkdown(sections.statement, validKeys),
  renderIfPresent(sections.definitions, validKeys),
  renderIfPresent(sections.partialResults, validKeys),
  renderIfPresent(sections.claimedProofs, validKeys),
  renderIfPresent(sections.notes, validKeys),
]);

const title = `${entry.data.name} (pending)`;
---

<BaseLayout title={title} excludeFromSearch>
  <p class="pending-banner">Pending review</p>
  <h1>{entry.data.name}</h1>

  <ProblemBody
    status={entry.data.status}
    impact={entry.data.impact}
    area={entry.data.area}
    canonicalReference={entry.data.canonical_reference}
    references={entry.data.references}
    statementHtml={statementHtml}
    definitionsHtml={definitionsHtml}
    partialResultsHtml={partialResultsHtml}
    claimedProofsHtml={claimedProofsHtml}
    notesHtml={notesHtml}
  />
</BaseLayout>

<style>
  .pending-banner {
    display: inline-block;
    margin: 0 0 0.6rem;
    padding: 0.35rem 0.9rem;
    border: var(--border-width) solid var(--color-claimed-border);
    background: var(--color-claimed-bg);
    border-radius: var(--radius-md);
    font-weight: 600;
  }
  h1 {
    margin-top: 0.1rem;
  }
</style>
