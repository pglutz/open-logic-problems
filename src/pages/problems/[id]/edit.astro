---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProblemEditor from "../../../components/islands/ProblemEditor";
import { splitSections } from "../../../lib/markdown/sections";

export async function getStaticPaths() {
  const problems = await getCollection("problems");
  return problems.map((entry) => ({
    params: { id: String(entry.data.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const sections = splitSections(entry.body ?? "");
---

<BaseLayout title={`Suggest an edit — Problem #${entry.data.id}`} maxWidth="1100px">
  <h1>Suggest an edit — Problem #{entry.data.id}</h1>
  <ProblemEditor
    problem={{
      id: entry.data.id,
      name: entry.data.name,
      status: entry.data.status,
      area: entry.data.area,
      impact: entry.data.impact,
      canonicalReference: entry.data.canonical_reference,
    }}
    sections={{
      statement: sections.statement,
      definitions: sections.definitions ?? "",
      partialResults: sections.partialResults ?? "",
      claimedProofs: sections.claimedProofs ?? "",
      additionalReferences: sections.additionalReferences ?? "",
      notes: sections.notes ?? "",
    }}
    client:load
  />
</BaseLayout>
