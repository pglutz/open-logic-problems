---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProblemEditor from "../../../components/islands/ProblemEditor";
import { splitSections } from "../../../lib/markdown/sections";

export async function getStaticPaths() {
  const problems = await getCollection("problems");
  return problems.map((entry) => ({
    params: { id: String(entry.data.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const sections = splitSections(entry.body ?? "");
---

<BaseLayout title={`Suggest an edit — Problem #${entry.data.id}`} maxWidth="1100px">
  <h1>Suggest an edit — Problem #{entry.data.id}</h1>
  <ProblemEditor
    problem={{
      id: entry.data.id,
      name: entry.data.name,
      status: entry.data.status,
      area: entry.data.area,
      impact: entry.data.impact,
      canonicalReference: entry.data.canonical_reference,
    }}
    sections={{
      statement: sections.statement,
      definitions: sections.definitions ?? "",
      partialResults: sections.partialResults ?? "",
      additionalReferences: sections.additionalReferences ?? "",
      notes: sections.notes ?? "",
    }}
    client:load
  />
</BaseLayout>

<style is:global>
  /* ProblemEditor is a React island; its markup is rendered client-side, so
     Astro's scoped-style attribute never reaches it — these rules must be
     global. */
  .editor-columns {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }
  .editor-left {
    flex: 1 1 50%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .editor-right {
    flex: 1 1 50%;
    min-width: 0;
    position: sticky;
    top: 1rem;
  }
  @media (max-width: 60rem) {
    .editor-columns {
      flex-direction: column;
    }
    .editor-right {
      position: static;
      width: 100%;
    }
  }

  .editor-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .editor-field label {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .editor-field input,
  .editor-field select,
  .editor-field textarea {
    font: inherit;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .editor-field input,
  .editor-field select {
    max-width: 30rem;
  }
  .editor-field textarea {
    font-family: ui-monospace, monospace;
    font-size: 0.9rem;
    resize: vertical;
  }

  .editor-inline-row {
    display: flex;
    gap: 1.25rem;
  }
  .editor-field-compact {
    flex: 0 0 auto;
  }
  .editor-select-compact {
    max-width: 12rem;
  }

  .editor-status-warning {
    margin: -0.5rem 0 0;
    padding: 0.6rem 0.8rem;
    border: var(--border-width) solid var(--color-claimed-border);
    background: var(--color-claimed-bg);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
  }

  .editor-collapsible {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.6rem 1rem;
  }
  .editor-collapsible summary {
    cursor: pointer;
    font-weight: 600;
  }
  .editor-collapsible[open] summary {
    margin-bottom: 0.5rem;
  }
  .editor-collapsible-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }
  .editor-area-checkboxes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }
  .editor-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 400;
    font-size: 0.95rem;
  }

  .editor-commit-message {
    font-family: inherit;
  }
  .editor-submit {
    align-self: flex-start;
    font-size: 1.05rem;
    font-weight: 600;
    padding: 0.65rem 1.5rem;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-link);
    background: var(--color-link);
    color: #fff;
    cursor: pointer;
  }
  .editor-submit:hover {
    opacity: 0.92;
  }
  .editor-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  /* Live preview — mirrors ProblemLayout.astro's markup/styles so the pane
     actually looks like the resulting problem page. */
  .editor-preview-page {
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
  }
  .editor-preview-id {
    margin: 0 0 0.1rem;
    font-size: 0.9rem;
  }
  .editor-preview-title {
    margin: 0.1rem 0 1.25rem;
    font-size: 1.6rem;
    line-height: 1.25;
  }
  .editor-preview-statement-box {
    margin: 0 0 1.5rem;
  }
  .editor-preview-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .editor-preview-impact {
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: help;
  }
  .editor-preview-statement-body p:last-child {
    margin-bottom: 0;
  }
  .editor-preview-area-row {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .editor-preview-area-row .area-tag {
    display: inline-block;
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-sm);
    background: rgba(128, 128, 128, 0.15);
    font-size: 0.85rem;
  }
  .editor-preview-section {
    margin-bottom: 1.5rem;
  }
  .editor-preview-section h3 {
    font-size: 1.1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.25rem;
    margin-bottom: 0.5rem;
  }
</style>
