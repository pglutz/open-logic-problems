---
import { getCollection } from "astro:content";
import ProblemLayout from "../../../layouts/ProblemLayout.astro";
import { renderMarkdown, renderIfPresent } from "../../../lib/markdown/pipeline";
import { splitSections } from "../../../lib/markdown/sections";

export async function getStaticPaths() {
  const problems = await getCollection("problems");
  return problems.map((entry) => ({
    params: { id: String(entry.data.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const sections = splitSections(entry.body ?? "");

const [
  statementHtml,
  definitionsHtml,
  partialResultsHtml,
  claimedProofsHtml,
  additionalReferencesHtml,
  notesHtml,
] = await Promise.all([
  renderMarkdown(sections.statement),
  renderIfPresent(sections.definitions),
  renderIfPresent(sections.partialResults),
  renderIfPresent(sections.claimedProofs),
  renderIfPresent(sections.additionalReferences),
  renderIfPresent(sections.notes),
]);
---

<ProblemLayout
  id={entry.data.id}
  name={entry.data.name}
  status={entry.data.status}
  area={entry.data.area}
  impact={entry.data.impact}
  canonicalReference={entry.data.canonical_reference}
  statementHtml={statementHtml}
  definitionsHtml={definitionsHtml}
  partialResultsHtml={partialResultsHtml}
  claimedProofsHtml={claimedProofsHtml}
  additionalReferencesHtml={additionalReferencesHtml}
  notesHtml={notesHtml}
/>
