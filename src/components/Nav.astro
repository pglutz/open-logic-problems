---
import AuthWidget from "./islands/AuthWidget";

const links = [
  { href: "/faq", label: "FAQ" },
  { href: "/problems", label: "List of Problems" },
  { href: "/problems/new", label: "Submit a New Problem" },
];
// Astro's static build uses directory-style routing (e.g. `/faq/index.html`), where
// Astro.url.pathname resolves to "/faq/" (trailing slash) — unlike astro dev's per-request
// SSR, which reflects the exact requested path with no slash added. Stripping it here keeps
// the comparison against `link.href` correct in both.
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="nav">
  <div class="nav-inner">
    <div class="nav-left">
      <a class="brand" href="/">Open Problems in Mathematical Logic</a>
      <details class="mobile-menu">
        <summary class="hamburger-button" aria-label="Menu">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <line x1="3" y1="18" x2="21" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </summary>
        <ul class="mobile-menu-list">
          <li>
            <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Home</a>
          </li>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={currentPath === link.href ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>

    <div class="nav-right">
      <nav class="desktop-nav">
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={currentPath === link.href ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul class="icon-group">
        <li>
          <AuthWidget client:load />
        </li>
        <li>
          <a
            class="icon-link"
            href="/search"
            aria-label="Search"
            title="Search"
            aria-current={currentPath === "/search" ? "page" : undefined}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
              <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  .nav {
    background: var(--color-nav-bg);
    color: var(--color-nav-text);
  }
  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.85rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .nav-left,
  .nav-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }
  .brand {
    color: var(--color-nav-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
  }
  .desktop-nav ul,
  .icon-group {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
  }
  .desktop-nav a,
  .mobile-menu-list a,
  .icon-group a {
    color: var(--color-nav-text);
    text-decoration: none;
    opacity: 0.85;
    font-size: 0.95rem;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"],
  .mobile-menu-list a:hover,
  .icon-group a:hover,
  .icon-group a[aria-current="page"] {
    opacity: 1;
    text-decoration: underline;
  }
  .icon-link {
    line-height: 0;
  }
  .icon-link svg {
    vertical-align: middle;
  }
  .icon-link:hover,
  .icon-link[aria-current="page"] {
    text-decoration: none;
  }

  /* Hamburger menu: hidden by default (desktop/tablet layout keeps the full
     brand text + inline link row), swapped in below the 600px breakpoint. */
  .mobile-menu {
    display: none;
    position: relative;
  }
  .hamburger-button {
    list-style: none;
    display: block;
    color: var(--color-nav-text);
    cursor: pointer;
    line-height: 0;
  }
  .hamburger-button::-webkit-details-marker {
    display: none;
  }
  .mobile-menu-list {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 12rem;
    margin: 0;
    padding: 0.75rem 1rem;
    list-style: none;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-nav-bg);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 47.6rem) {
    .brand {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .desktop-nav {
      display: none;
    }
  }
</style>

<style is:global>
  /* AuthWidget is a React island; its markup is rendered client-side, so
     Astro's scoped-style attribute never reaches it — these rules must be
     global. */
  .auth-widget {
    position: relative;
    font-size: 0.9rem;
  }
  .auth-icon-button {
    position: relative;
    line-height: 0;
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    cursor: pointer;
  }
  .auth-icon-button svg {
    vertical-align: middle;
  }
  .auth-signed-in-dot {
    position: absolute;
    top: -1px;
    right: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4caf50;
    border: var(--border-width) solid var(--color-nav-bg);
  }
  .auth-popover {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 15rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }
  .auth-popover form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .auth-popover input[type="email"] {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .auth-popover button {
    align-self: flex-start;
    font-size: 0.85rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  .auth-popover button:hover {
    opacity: 0.85;
  }
  .auth-status {
    color: var(--color-text);
  }
  .auth-error {
    color: var(--color-error-text);
  }
</style>

<script>
  const mobileMenu = document.querySelector(".mobile-menu");
  const hamburgerButton = document.querySelector(".hamburger-button");

  if (mobileMenu instanceof HTMLDetailsElement) {
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mobileMenu.open) {
        mobileMenu.open = false;
        if (hamburgerButton instanceof HTMLElement) hamburgerButton.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (mobileMenu.open && e.target instanceof Node && !mobileMenu.contains(e.target)) {
        mobileMenu.open = false;
      }
    });
  }
</script>
