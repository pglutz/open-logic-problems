---
import { IMPACT_RUBRIC } from "../lib/problems";

interface Props {
  impact: 1 | 2 | 3;
}
const { impact } = Astro.props;
---

<span class="impact" title={IMPACT_RUBRIC[impact]}>
  {"!".repeat(impact)}
  <span class="visually-hidden">{IMPACT_RUBRIC[impact]}</span>
</span>

<style>
  .impact {
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: help;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
