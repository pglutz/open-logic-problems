---
interface Props {
  status: "open" | "closed" | "claimed-proof-no-consensus";
}
const { status } = Astro.props;

const LABELS: Record<Props["status"], string> = {
  open: "Open",
  closed: "Closed",
  "claimed-proof-no-consensus": "No consensus",
};
---

<span class:list={["badge", `status-${status}`]}>{LABELS[status]}</span>
