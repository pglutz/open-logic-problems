---
import Nav from "../components/Nav.astro";
import "katex/dist/katex.min.css";
import "@fontsource/open-sans/400.css";
import "@fontsource/open-sans/500.css";
import "@fontsource/open-sans/600.css";
import "@fontsource/open-sans/700.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  excludeFromSearch?: boolean;
  maxWidth?: string;
  // Present when this layout is used as a Markdown page's `layout:` frontmatter
  // field — Astro nests that page's frontmatter here instead of spreading it.
  frontmatter?: { title?: string; description?: string };
}

const props = Astro.props;
const title = props.title ?? props.frontmatter?.title;
const description = props.description ?? props.frontmatter?.description;
const { excludeFromSearch, maxWidth } = props;

const fullTitle = `${title} · Open Problems in Mathematical Logic`;
const SITE_URL = "https://www.openlogicproblems.com";
const pageUrl = `${SITE_URL}${Astro.url.pathname}`;
const thumbnailUrl = `${SITE_URL}/thinker_thumbnail.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <!-- So link previews on messaging/social platforms show this image
         consistently, instead of each platform guessing (some fall back to
         the favicon, some scrape the page for something image-shaped). -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:image:width" content="1199" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={thumbnailUrl} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <Nav />
    <main
      data-pagefind-body={excludeFromSearch ? undefined : true}
      style={maxWidth ? `--max-width: ${maxWidth}` : undefined}
    >
      <slot />
    </main>
  </body>
</html>
