---
import Nav from "../components/Nav.astro";
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  excludeFromSearch?: boolean;
  maxWidth?: string;
}

const { title, description, excludeFromSearch, maxWidth } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Open Problems in Mathematical Logic</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <Nav />
    <main
      data-pagefind-body={excludeFromSearch ? undefined : true}
      style={maxWidth ? `--max-width: ${maxWidth}` : undefined}
    >
      <slot />
    </main>
  </body>
</html>
