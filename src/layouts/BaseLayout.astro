---
import Nav from "../components/Nav.astro";
import "katex/dist/katex.min.css";
import "@fontsource/open-sans/400.css";
import "@fontsource/open-sans/500.css";
import "@fontsource/open-sans/600.css";
import "@fontsource/open-sans/700.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  excludeFromSearch?: boolean;
  maxWidth?: string;
  // Present when this layout is used as a Markdown page's `layout:` frontmatter
  // field — Astro nests that page's frontmatter here instead of spreading it.
  frontmatter?: { title?: string; description?: string };
}

const props = Astro.props;
const title = props.title ?? props.frontmatter?.title;
const description = props.description ?? props.frontmatter?.description;
const { excludeFromSearch, maxWidth } = props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Open Problems in Mathematical Logic</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <Nav />
    <main
      data-pagefind-body={excludeFromSearch ? undefined : true}
      style={maxWidth ? `--max-width: ${maxWidth}` : undefined}
    >
      <slot />
    </main>
  </body>
</html>
