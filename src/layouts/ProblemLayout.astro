---
import BaseLayout from "./BaseLayout.astro";
import ProblemBody from "../components/react/ProblemBody";
import CommentSection from "../components/islands/CommentSection";
import type { Area } from "../lib/areas";
import type { ProblemStatus } from "../lib/problems";
import type { CanonicalReference } from "../lib/problemSchema";

interface Props {
  id: number;
  name: string;
  status: ProblemStatus;
  area: Area[];
  impact: 1 | 2 | 3;
  canonicalReference: CanonicalReference;
  statementHtml: string;
  definitionsHtml?: string;
  partialResultsHtml?: string;
  claimedProofsHtml?: string;
  additionalReferencesHtml?: string;
  notesHtml?: string;
}

const {
  id,
  name,
  status,
  area,
  impact,
  canonicalReference,
  statementHtml,
  definitionsHtml,
  partialResultsHtml,
  claimedProofsHtml,
  additionalReferencesHtml,
  notesHtml,
} = Astro.props;

const title = name;
---

<BaseLayout title={title}>
  <p class="muted problem-id">Problem #{id}</p>
  <h1>{name}</h1>

  <ProblemBody
    status={status}
    impact={impact}
    area={area}
    canonicalReference={canonicalReference}
    statementHtml={statementHtml}
    definitionsHtml={definitionsHtml}
    partialResultsHtml={partialResultsHtml}
    claimedProofsHtml={claimedProofsHtml}
    additionalReferencesHtml={additionalReferencesHtml}
    notesHtml={notesHtml}
    suggestEditHref={`/problems/${id}/edit`}
  />

  <section class="problem-section">
    <h2 class="section-heading">Comments</h2>
    <CommentSection problemId={id} client:load />
  </section>
</BaseLayout>

<style>
  .problem-id {
    margin-bottom: 0;
  }
  h1 {
    margin-top: 0.1rem;
  }
</style>

<style is:global>
  /* CommentSection is a React island; its markup is rendered client-side, so
     Astro's scoped-style attribute never reaches it — these rules must be
     global. */
  .comment-list {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .comment {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .comment-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.3rem;
    font-size: 0.85rem;
  }
  .comment-number {
    color: var(--color-text-muted);
  }
  .comment-author {
    font-weight: 600;
  }
  .comment-date {
    color: var(--color-text-muted);
  }
  .comment-body p {
    margin: 0.5rem 0;
  }
  .comment-body p:first-child {
    margin-top: 0;
  }
  .comment-body p:last-child {
    margin-bottom: 0;
  }
  .comment-pending-badge {
    background: var(--color-border);
  }
  .comment-rejected-badge {
    background: var(--color-closed-bg);
    border-color: var(--color-closed-border);
  }
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 32rem;
  }
  .comment-form input,
  .comment-form textarea {
    font: inherit;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    border: var(--border-width-thick) solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .comment-form button {
    align-self: flex-start;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.45rem 1.1rem;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-link);
    background: var(--color-link);
    color: #fff;
    cursor: pointer;
  }
  .comment-form button:hover {
    opacity: 0.92;
  }
  .comment-form button:disabled {
    opacity: 0.6;
    cursor: default;
  }
</style>
