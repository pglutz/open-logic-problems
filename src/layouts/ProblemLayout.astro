---
import BaseLayout from "./BaseLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import AreaTags from "../components/AreaTags.astro";
import ImpactMarks from "../components/ImpactMarks.astro";
import CommentSection from "../components/islands/CommentSection";
import type { Area } from "../lib/areas";

interface CanonicalReference {
  title: string;
  author: string;
  venue?: string;
  year?: number;
  link?: string;
}

interface Props {
  id: number;
  name?: string;
  status: "open" | "closed" | "claimed-proof-no-consensus";
  area: Area[];
  impact: 1 | 2 | 3;
  canonicalReference: CanonicalReference;
  statementHtml: string;
  definitionsHtml?: string;
  partialResultsHtml?: string;
  additionalReferencesHtml?: string;
  notesHtml?: string;
}

const {
  id,
  name,
  status,
  area,
  impact,
  canonicalReference,
  statementHtml,
  definitionsHtml,
  partialResultsHtml,
  additionalReferencesHtml,
  notesHtml,
} = Astro.props;

const title = name ? `${name} (#${id})` : `Problem #${id}`;
---

<BaseLayout title={title}>
  <p class="muted problem-id">Problem #{id}</p>
  {name && <h1>{name}</h1>}
  {!name && <h1>Problem #{id}</h1>}

  <p class="muted"><a href={`/problems/${id}/edit`}>Suggest an edit to this problem</a></p>

  <div class:list={["status-box", "statement-box", `status-${status}`]}>
    <div class="meta-row">
      <StatusBadge status={status} />
      <ImpactMarks impact={impact} />
    </div>
    <div class="statement-body" set:html={statementHtml} />
    <div class="area-row">
      <AreaTags areas={area} />
    </div>
  </div>

  <section class="reference">
    <h2>Reference</h2>
    <p>
      {canonicalReference.author}, <em>{canonicalReference.title}</em>
      {canonicalReference.venue && <>, {canonicalReference.venue}</>}
      {canonicalReference.year && <>, {canonicalReference.year}</>}
      {canonicalReference.link && (
        <>
          {" "}
          (<a href={canonicalReference.link}>link</a>)
        </>
      )}
    </p>
  </section>

  {
    definitionsHtml && (
      <section>
        <h2>Definitions</h2>
        <div set:html={definitionsHtml} />
      </section>
    )
  }

  {
    partialResultsHtml && (
      <section>
        <h2>Known Partial Results</h2>
        <div set:html={partialResultsHtml} />
      </section>
    )
  }

  {
    notesHtml && (
      <section>
        <h2>Notes</h2>
        <div set:html={notesHtml} />
      </section>
    )
  }

  {
    additionalReferencesHtml && (
      <section>
        <h2>Additional References</h2>
        <div set:html={additionalReferencesHtml} />
      </section>
    )
  }

  <section>
    <h2>Comments</h2>
    <CommentSection problemId={id} client:load />
  </section>
</BaseLayout>

<style>
  .problem-id {
    margin-bottom: 0;
  }
  h1 {
    margin-top: 0.1rem;
  }
  .statement-box {
    margin: 1.25rem 0 2rem;
  }
  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .statement-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .area-row {
    margin-top: 0.85rem;
  }
  section {
    margin-bottom: 2rem;
  }
  section h2 {
    font-size: 1.15rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.25rem;
  }
</style>

<style is:global>
  /* CommentSection is a React island; its markup is rendered client-side, so
     Astro's scoped-style attribute never reaches it — these rules must be
     global. */
  .comment-list {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .comment {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .comment-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.3rem;
    font-size: 0.85rem;
  }
  .comment-number {
    color: var(--color-text-muted);
  }
  .comment-author {
    font-weight: 600;
  }
  .comment-date {
    color: var(--color-text-muted);
  }
  .comment-body p {
    margin: 0.5rem 0;
  }
  .comment-body p:first-child {
    margin-top: 0;
  }
  .comment-body p:last-child {
    margin-bottom: 0;
  }
  .comment-pending-badge {
    background: var(--color-border);
  }
  .comment-rejected-badge {
    background: var(--color-closed-bg);
    border-color: var(--color-closed-border);
  }
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 32rem;
  }
  .comment-form input,
  .comment-form textarea {
    font: inherit;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .comment-form button {
    align-self: flex-start;
    font-size: 0.9rem;
    padding: 0.35rem 0.9rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
  }
  .comment-error {
    color: #c0392b;
    font-size: 0.85rem;
    margin: 0;
  }
  .link-button {
    font: inherit;
    color: var(--color-link);
    background: none;
    border: none;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .comment-signin-prompt {
    margin: 0;
    padding: 0.8rem 1rem;
    border: 2px solid var(--color-border);
    border-radius: 6px;
    font-size: 1.02rem;
    font-weight: 500;
  }
  .comment-signin-prompt .link-button {
    font-weight: 700;
  }
</style>
